generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPERVISOR
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(USER)
  active       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  // Fuso do usuario: os timestamps ficam em UTC e a agregacao (dia, semana,
  // streak) acontece neste fuso. Trocar de fuso esticaria a semana, entao a
  // alteracao fica restrita ao supervisor na camada de servico.
  timezone     String      @default("America/Sao_Paulo")
  timeEntries  TimeEntry[]

  memberships         Membership[]
  workoutSessions     WorkoutSession[]
  // Correcoes que este usuario fez (pode ser em sessao de outra pessoa,
  // quando um supervisor corrige).
  authoredCorrections SessionCorrection[] @relation("correctionAuthor")

  weeklyGoal    WeeklyGoal?
  weeklyResults WeeklyResult[]
  achievements  Achievement[]
}

enum TimeEntryType {
  CHECK_IN
  CHECK_OUT
}

// Mantido como esta, de proposito: e o historico bruto que ja existe e passa a
// valer como registro de auditoria da epoca anterior as sessoes. A partir da
// v0.9 as escritas novas vao para WorkoutSession.
model TimeEntry {
  id        String        @id @default(uuid())
  type      TimeEntryType
  timestamp DateTime      @default(now())
  userId    String
  // Cascade: excluir a conta tem de apagar de verdade o historico da pessoa
  // (LGPD). Sem isso o Prisma usa Restrict e a exclusao falha para qualquer
  // usuario que ja tenha batido ponto -- ou seja, todos.
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Grupo ---
// Modelado desde a primeira migration, mesmo havendo um grupo so: criar as
// tabelas e vincular todo mundo depois, com dados em producao, sairia caro.
model Group {
  id        String   @id @default(uuid())
  name      String
  // Identificador estavel para o convite por link (v1.3).
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships     Membership[]
  workoutSessions WorkoutSession[]
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Uma pessoa entra uma vez por grupo.
  @@unique([userId, groupId])
  @@index([groupId])
}

enum SessionStatus {
  OPEN // em andamento
  COMPLETED // fechada normalmente
  SHORT // fechada abaixo da duracao minima -> nao contabil
  AUTO_CLOSED // fechada pelo sistema por ficar aberta demais -> nao contabil
}

// O que a pessoa treinou. Lista curta de proposito: e um rotulo para ela se
// reconhecer no historico, nao um catalogo de exercicios (isso e a Fase B).
enum WorkoutType {
  PEITO
  COSTAS
  PERNAS
  OMBROS
  BRACOS
  ABDOMEN
  CARDIO
  CORPO_INTEIRO
  OUTRO
}

enum SessionSource {
  APP // a pessoa tocou o botao
  BACKFILL // criada na migracao, a partir dos TimeEntry antigos
  SYSTEM // auto-encerramento
  CORRECTION // resultado de uma correcao manual
}

// A entidade que faltava: um treino e uma sessao, nao dois registros soltos.
// Sem ela nao havia onde pendurar duracao, regras de integridade nem, mais pra
// frente, series e cargas.
model WorkoutSession {
  id      String  @id @default(uuid())
  userId  String
  // Desnormalizado na sessao para as consultas de grupo (placar) nao terem de
  // passar por Membership a cada leitura.
  groupId String?

  // Sempre gerados no servidor, nunca aceitos do cliente. Guardados em UTC.
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?

  status SessionStatus @default(OPEN)
  source SessionSource @default(APP)

  // Dia (YYYY-MM-DD) ja resolvido no fuso do usuario. Existe para a regra de
  // "1 treino contavel por dia" e para as agregacoes por dia/semana virarem
  // group by, em vez de recalcular fuso a cada leitura.
  dayKey String

  // --- Registro do treino, Fase A (v2.0) ---
  //
  // Tudo opcional, e de proposito: o check-out e a acao que sustenta streak,
  // meta e placar. Exigir preenchimento ali arriscaria a metrica que ja
  // funciona para ganhar uma que ainda nao existe.
  //
  // Nada aqui entra em contagem nenhuma. Por isso estes campos NAO passam pela
  // trava de correcao (uma por sessao, teto de +1h): aquela existe porque
  // horario decide o que conta, e rotulo nao decide nada.

  // Lista porque "peito e triceps" e o caso comum; um valor so empurraria a
  // maioria para OUTRO e estragaria justamente o sinal que queremos medir.
  workoutTypes WorkoutType[]

  // Esforco percebido de 1 a 5. E percepcao de treino, nao medida clinica --
  // dado de saude esta fora do produto (LGPD art. 11).
  effort Int?

  // Texto livre curto. E aqui que a Fase A vira evidencia para decidir a Fase
  // B: se as pessoas escreverem "supino 4x10 com 40kg", o registro estruturado
  // se justifica; se ficar vazio, nao se justificava mesmo.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       Group?              @relation(fields: [groupId], references: [id])
  corrections SessionCorrection[]

  @@index([userId, dayKey])
  @@index([userId, startedAt])
  @@index([groupId, dayKey])
}

// Auditoria: nada muda sem deixar rastro. Editar uma sessao grava aqui o antes,
// o depois, quem fez e por que. Esta tabela e somente-append.
model SessionCorrection {
  id        String   @id @default(uuid())
  sessionId String
  // Nulavel de proposito: excluir a conta tem de apagar de verdade (LGPD),
  // mas a auditoria nao pode desaparecer. Apagar o autor anonimiza a correcao
  // em vez de bloquear a exclusao ou destruir o rastro.
  authorId  String?
  reason    String
  createdAt DateTime @default(now())

  // Valores antes e depois da correcao (nulo = campo nao mexido).
  startedAtBefore DateTime?
  startedAtAfter  DateTime?
  endedAtBefore   DateTime?
  endedAtAfter    DateTime?
  statusBefore    SessionStatus?
  statusAfter     SessionStatus?

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User?          @relation("correctionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([authorId])
}

// --- Meta semanal e streak de semanas (v1.0) ---

enum WeekStatus {
  CUMPRIDA // bateu a meta
  CONGELADA // nao bateu, mas gastou um congelamento: nao avanca e nao zera
  PERDIDA // nao bateu e nao tinha congelamento: zera a streak
}

// Configuracao da pessoa. Fica separada do resultado porque muda por vontade
// do usuario, enquanto o resultado e consequencia dos treinos.
model WeeklyGoal {
  userId String @id
  // Dias distintos com treino contavel exigidos por semana (3 a 6).
  meta   Int    @default(3)

  // Meta agendada. Trocar a meta NUNCA vale para a semana corrente -- senao
  // bastaria baixar de 5 para 3 no domingo a noite para "cumprir" a semana.
  metaPendente Int?
  // Semana (segunda, YYYY-MM-DD) a partir da qual metaPendente entra em vigor.
  metaValidaDe String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Fechamento de uma semana. Uma linha por (usuario, semana), criada de forma
// preguicosa na primeira leitura depois que a semana acabou.
//
// A linha guarda o ESTADO INTEIRO depois do fechamento, nao so o desfecho: a
// semana mais recente e, sozinha, o estado atual da pessoa. Isso evita uma
// tabela de estado mutavel paralela (que sairia do lugar) e deixa a historia
// auditavel -- da para explicar cada streak olhando as linhas.
model WeeklyResult {
  id     String @id @default(uuid())
  userId String

  // Identificada pela segunda-feira ja resolvida no fuso do usuario, em vez do
  // numero ISO da semana: e a mesma semana ISO, sem os casos de borda de W53 e
  // de ano ISO diferente do ano civil.
  semanaInicio String
  semanaFim    String

  meta    Int
  treinos Int
  status  WeekStatus

  reparo            Boolean @default(false)
  congelamentoUsado Boolean @default(false)

  streakAntes       Int
  streakDepois      Int
  tokensDepois      Int
  // Streak guardada por uma semana PERDIDA, para o reparo da semana seguinte.
  streakSalva       Int?
  // Semanas CUMPRIDA seguidas, para ganhar congelamento a cada 4.
  cumpridasSeguidas Int     @default(0)
  // Semana do ultimo reparo, carregada adiante: um reparo por trimestre.
  ultimoReparoEm    String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotencia do fechamento preguicoso: duas requisicoes simultaneas nao
  // fecham a mesma semana duas vezes -- a segunda esbarra aqui.
  @@unique([userId, semanaInicio])
  @@index([userId, semanaInicio])
}

// --- Conquistas: marcos e recordes (v1.0) ---

// Marcos sao fixos (bateu, bateu para sempre); recordes tem valor que melhora.
// A mesma tabela serve aos dois porque a mecanica e a mesma -- o que muda e se
// `value` existe e pode subir.
enum AchievementKind {
  MARCO
  RECORDE
}

model Achievement {
  id     String @id @default(uuid())
  userId String

  /// Codigo do catalogo (ver src/sessions/conquistas.ts). O catalogo vive no
  /// codigo, e nao no banco: sao regras, nao dados do usuario.
  code String
  kind AchievementKind

  /// So para RECORDE: a marca atual. Marco nao tem valor, so a data.
  value Int?

  /// Quando foi conquistado -- ou, no recorde, quando a marca foi superada.
  unlockedAt DateTime @default(now())

  /// Quando a pessoa VIU a comemoracao. Nulo = ainda tem festa a fazer.
  /// Sem isso, a tela comemoraria o mesmo marco em toda visita.
  seenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uma linha por conquista por pessoa: e o que torna a avaliacao preguicosa
  // segura de repetir, como no fechamento semanal.
  @@unique([userId, code])
  @@index([userId])
}
