# Banco Postgres.
# - Dev local: um Postgres na sua maquina (ex.: banco gym_monkey_dev).
# - Producao: a connection string do Neon (Settings > Connection Details).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gym_monkey_dev?schema=public"

# Segredo de assinatura do JWT. OBRIGATORIO e com no minimo 32 caracteres -
# o app se recusa a subir sem um valor forte (ver src/config/env.validation.ts).
# Gere um assim:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-forte-de-no-minimo-32-caracteres"

PORT=3000

# Origem liberada no CORS. Em producao, a URL publica do frontend (GitHub Pages).
FRONTEND_URL="http://localhost:5173"
