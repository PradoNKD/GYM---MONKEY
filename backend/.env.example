# Banco. Em dev usamos SQLite; em producao, a URL do Postgres do Railway.
DATABASE_URL="file:./dev.db"

# Segredo de assinatura do JWT. OBRIGATORIO e com no minimo 32 caracteres -
# o app se recusa a subir sem um valor forte (ver src/config/env.validation.ts).
# Gere um assim:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-forte-de-no-minimo-32-caracteres"

PORT=3000

# Origem liberada no CORS. Em producao, a URL publica do frontend.
FRONTEND_URL="http://localhost:5173"
